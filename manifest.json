{
  "manifest_version": 3,
  "name": "Roman Urdu Translator",
  "version": "1.0.0",
  "description": "Translate English webpages into natural Pakistani Roman Urdu.",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "key": "",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Roman Urdu Translator"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/text-utils.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
