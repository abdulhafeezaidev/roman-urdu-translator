# Roman Urdu Translator — Backend Environment Configuration Example
# Copy this file to .env and set your Google Gemini API key.
# DO NOT commit .env to version control.

PORT=3000
# Provider selection: 'gemini' (default) or 'huggingface'
TRANSLATION_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Configuration (requires "Make calls to serverless Inference API" token permission)
HF_API_KEY=your_huggingface_token_here
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

ALLOWED_ORIGINS=chrome-extension://*,http://localhost:3000
REQUEST_TIMEOUT_MS=30000
MAX_BATCH_ITEMS=50
MAX_BATCH_CHARACTERS=8000
